---
import events from '../data/events.json';
const { bePart, pastEvents, liveScores } = events;
const initialVisible = pastEvents.initialVisible;
const hasMore = initialVisible != null && pastEvents.photos.length > initialVisible;
---

<!-- ============ 8 · The Events ============ -->
<section class="section" id="events" aria-labelledby="events-h">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{events.eyebrow}</p>
      <h2 class="h2" id="events-h">{events.heading}</h2>
    </div>
    <div class="events-grid">
      {events.cards.map((c) => (
        <article class={`event-card reveal${c.delay ? ` ${c.delay}` : ''}`}>
          <div class="event-img"><span class="event-date">{c.date}</span><img src={c.img} width={c.width} height={c.height} alt={c.alt} loading="lazy" /></div>
          <div class="event-body">
            <h3>{c.name}</h3>
            <p class="event-venue">{c.venue}</p>
            <p>{c.blurb}</p>
            {c.linkHref && (
              <a
                class="event-link"
                href={c.linkHref}
                {...(/^https?:\/\//i.test(c.linkHref) ? { target: '_blank', rel: 'noopener' } : {})}
              >{c.linkLabel || 'Find out more'} <span aria-hidden="true">&rarr;</span></a>
            )}
            {c.link2Href && (
              <a
                class="event-link"
                href={c.link2Href}
                {...(/^https?:\/\//i.test(c.link2Href) ? { target: '_blank', rel: 'noopener' } : {})}
              >{c.link2Label || 'Find out more'} <span aria-hidden="true">&rarr;</span></a>
            )}
            {c.link3Href && (
              <a
                class="event-link"
                href={c.link3Href}
                {...(/^https?:\/\//i.test(c.link3Href) ? { target: '_blank', rel: 'noopener' } : {})}
              >{c.link3Label || 'Find out more'} <span aria-hidden="true">&rarr;</span></a>
            )}
            {c.qrImg && (
              <a class="event-qr" href={c.qrHref || c.link3Href || c.linkHref} target="_blank" rel="noopener">
                <img src={c.qrImg} width="88" height="88" alt={`QR code: ${c.qrLabel || 'scan to open'}`} loading="lazy" />
                <span>{c.qrLabel || 'Scan with your phone'}</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    {liveScores?.enabled && (
      <div class="live-panel reveal" id="live-scores">
        <div class="lp-text">
          <p class="lp-eyebrow"><span class="lp-dot" aria-hidden="true"></span>{liveScores.eyebrow}</p>
          <h3 class="lp-title">{liveScores.heading}</h3>
          <p class="lp-body" set:html={liveScores.text} />
          {liveScores.href && (
            <a class="btn btn--white lp-btn" href={liveScores.href} target="_blank" rel="noopener">{liveScores.buttonLabel || 'Open live scores'} <span aria-hidden="true">&rarr;</span></a>
          )}
        </div>
        {liveScores.qr && (
          <a class="lp-qr" href={liveScores.href} target="_blank" rel="noopener">
            <img src={liveScores.qr} width="480" height="480" alt="QR code for live scores of the 3x3 charity basketball tournament" loading="lazy" />
            <span>{liveScores.qrCaption || 'Scan with your phone camera'}</span>
          </a>
        )}
      </div>
    )}

    <div class="bepart reveal">
      <h3>{bePart.heading}</h3>
      <p class="bp-sub">{bePart.sub}</p>
      <div class="bepart-grid">
        {bePart.items.map((it) => (
          <a class="bp-item" href={it.mailto} {...(it.mailto?.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}><div class="bp-num"></div><h4>{it.title}</h4><p>{it.text}</p></a>
        ))}
      </div>
      {bePart.cta && bePart.cta.href && (
        <div class="bp-cta">
          <a class="btn btn--primary btn--lg" href={bePart.cta.href} target="_blank" rel="noopener">{bePart.cta.label}</a>
        </div>
      )}
    </div>

    <div class="past-events">
      <div class="pe-head reveal">
        <p class="pe-eyebrow"><svg class="pe-star" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-star"/></svg> {pastEvents.eyebrow}</p>
        <h3 class="pe-title" set:html={pastEvents.title} />
      </div>
      <div class="pe-gallery">
        {pastEvents.photos.map((p, i) => (
          <figure class={`pe-photo reveal${p.delay ? ` ${p.delay}` : ''}${initialVisible != null && i >= initialVisible ? ' is-extra' : ''}`}><img src={p.src} width={p.width} height={p.height} alt={p.alt} loading="lazy" /></figure>
        ))}
      </div>
      {hasMore && (
        <div class="pe-more">
          <button type="button" class="btn btn--outline pe-more-btn" aria-expanded="false">Show more photos</button>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  /* QR on an event card: handy on desktop/tablet (scan with your phone). Hidden on phones, where the link above does the job. */
  .event-qr { display: flex; align-items: center; gap: 12px; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--hairline); text-decoration: none; color: var(--grey); font-size: .8rem; line-height: 1.35; }
  .event-qr img { width: 88px; height: 88px; flex: none; border-radius: 6px; image-rendering: pixelated; }
  .event-qr span { max-width: 16ch; }
  .event-qr:hover span { color: var(--blue); }
  @media (max-width: 700px) { .event-qr { display: none; } }

  /* Live scores panel (basketball tournament) */
  .live-panel { margin-top: clamp(40px, 5vw, 64px); display: grid; grid-template-columns: 1fr auto; align-items: center; gap: clamp(24px, 4vw, 56px); background: var(--blue); color: #fff; border-radius: var(--radius-lg); padding: clamp(28px, 4.5vw, 52px); box-shadow: var(--shadow-blue); }
  .lp-eyebrow { font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; font-weight: 700; color: rgba(255,255,255,.85); }
  .lp-dot { display: inline-block; vertical-align: middle; margin: -2px 10px 0 0; width: 9px; height: 9px; border-radius: 50%; background: #ff5a4f; box-shadow: 0 0 0 0 rgba(255,90,79,.6); animation: lp-pulse 1.8s infinite; }
  @keyframes lp-pulse { 0% { box-shadow: 0 0 0 0 rgba(255,90,79,.6); } 70% { box-shadow: 0 0 0 10px rgba(255,90,79,0); } 100% { box-shadow: 0 0 0 0 rgba(255,90,79,0); } }
  .lp-title { font-size: clamp(1.5rem, 2.6vw, 2.1rem); margin: 12px 0 12px; color: #fff; }
  .lp-body { color: rgba(255,255,255,.88); max-width: 46ch; line-height: 1.6; }
  .lp-btn { margin-top: 22px; }
  .lp-qr { display: flex; flex-direction: column; align-items: center; gap: 10px; background: #fff; border-radius: var(--radius); padding: 16px 16px 12px; text-decoration: none; color: var(--grey); font-size: .8rem; font-weight: 600; transition: transform .25s var(--ease); }
  .lp-qr:hover { transform: translateY(-3px); }
  .lp-qr img { width: clamp(150px, 16vw, 190px); height: auto; display: block; }
  @media (max-width: 700px) {
    .live-panel { grid-template-columns: 1fr; text-align: center; }
    .lp-body { margin-inline: auto; }
    .lp-qr { justify-self: center; }
    .lp-qr img { width: 150px; }
  }
  @media (prefers-reduced-motion: reduce) { .lp-dot { animation: none; } }
</style>
