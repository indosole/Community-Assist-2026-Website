---
import data from '../data/logostrip.json';
import { sizeLogo } from './logos.js';
const logos = await Promise.all((data.logos || []).filter((l) => l.src).map(async (l) => ({ ...l, k: await sizeLogo(l.src, 30) })));
---

<!-- ============ 4b · Logo strip (scrolling marquee) ============ -->
<section class="logostrip reveal" aria-label={data.label || 'Our partners and supporters'}>
  {data.label && <p class="logostrip-label">{data.label}</p>}
  <div class="marquee">
    <div class="marquee-track">
      <ul class="marquee-group">
        {logos.map((l) => (
          <li><img class="mlogo" src={l.src} width={l.width} height={l.height} alt={l.alt} loading="lazy" style={`height: calc(${l.k} * var(--logo-u))`} /></li>
        ))}
      </ul>
      <ul class="marquee-group" aria-hidden="true">
        {logos.map((l) => (
          <li><img class="mlogo" src={l.src} width={l.width} height={l.height} alt="" loading="lazy" style={`height: calc(${l.k} * var(--logo-u))`} /></li>
        ))}
      </ul>
    </div>
  </div>
</section>
