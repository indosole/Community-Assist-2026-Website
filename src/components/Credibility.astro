---
import cred from '../data/credibility.json';
import { sizeLogo } from './logos.js';
const withSrc = (cred.partnerLogos || []).filter((l) => l.src);
const lead = await Promise.all(withSrc.slice(0, 4).map(async (l) => ({ ...l, k: await sizeLogo(l.src, 38) })));
const rest = await Promise.all(withSrc.slice(4).map(async (l) => ({ ...l, k: await sizeLogo(l.src, 22) })));
---

<!-- ============ 2 · Credibility band ============ -->
<section class="cred section section--tight" aria-label="Our impact in numbers">
  <div class="wrap">
    <div class="cred-stats">
      {cred.stats.map((s, i) => (
        <div class={`stat reveal${i > 0 ? ` d${i}` : ''}`}>
          <div class="stat-num">{s.accent ? <span class="accent">{s.num}</span> : s.num}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
    <div class="cred-logos reveal">
      <p class="ll-label">{cred.partnersLabel}</p>
      {/* First 4 are the lead partners (Community Assist Partners), shown larger as a lead line. */}
      <div class="logo-row logo-row--lead">
        {lead.map((l) => (
          <img class="plogo plogo--lead" src={l.src} width={l.width} height={l.height} alt={l.alt} loading="lazy" style={`height: calc(${l.k} * var(--logo-u))`} />
        ))}
      </div>
      <div class="logo-row">
        {rest.map((l) => (
          <img class="plogo" src={l.src} width={l.width} height={l.height} alt={l.alt} loading="lazy" style={`height: calc(${l.k} * var(--logo-u))`} />
        ))}
      </div>
    </div>
  </div>
</section>
